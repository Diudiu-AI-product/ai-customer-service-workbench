# =========================
# 必填配置
# =========================

# 大模型 API Key
API_KEY=请填写你的_API_KEY

# 闲鱼网页端完整 Cookie 字符串
COOKIES_STR=请填写你的_COOKIE


# =========================
# 模型配置
# =========================

# OpenAI 兼容接口地址
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名称
MODEL_NAME=qwen-max


# =========================
# 客服运行配置
# =========================

# 人工接管切换关键词
# 默认示例为英文句点，实际可改成你更顺手的关键词
TOGGLE_KEYWORDS=.

# 是否模拟人工输入延迟
SIMULATE_HUMAN_TYPING=False

# 人工接管模式超时时间，单位为秒
MANUAL_MODE_TIMEOUT=3600

# 消息过期时间，单位为毫秒
MESSAGE_EXPIRE_TIME=300000


# =========================
# 连接与保活配置
# =========================

# 心跳发送间隔，单位为秒
HEARTBEAT_INTERVAL=15

# 心跳超时时间，单位为秒
HEARTBEAT_TIMEOUT=5

# Token 刷新间隔，单位为秒
TOKEN_REFRESH_INTERVAL=3600

# Token 刷新失败后的重试间隔，单位为秒
TOKEN_RETRY_INTERVAL=300


# =========================
# 日志配置
# =========================

# 可选值通常为 DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=DEBUG
